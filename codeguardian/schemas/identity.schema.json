{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "repository",
    "pr_number",
    "base_sha",
    "head_sha",
    "run_id",
    "run_attempt",
    "policy_version"
  ],
  "additionalProperties": false
}
