{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "findings",
        "error",
        "skipped"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "enum": [
              "1"
            ]
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_status": {
            "enum": [
              "verified",
              "suspected",
              "unverified"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "schema_version",
          "finding_id",
          "fingerprint",
          "rule_id",
          "source",
          "severity",
          "evidence_status",
          "title",
          "explanation",
          "recommendation",
          "head_sha"
        ],
        "additionalProperties": false
      }
    },
    "coverage_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "logs_artifact": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "tool",
    "version",
    "status",
    "duration_ms",
    "findings",
    "coverage_scope",
    "logs_artifact"
  ],
  "additionalProperties": false
}
